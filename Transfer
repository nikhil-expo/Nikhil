# Bottom of handle from floor
HANDLE_BOTTOM = 0.85
# Handle is positioned near the joining edge of each door
HANDLE_EDGE_GAP = 0.035
# ------------------------------------------------------------
# FUNCTION: CREATE RECESSED HANDLE CUTTER
# ------------------------------------------------------------
def create_handle_cut(
   door_obj,
   handle_x,
   handle_bottom,
   handle_height,
   handle_name
):
   # Vertical rectangular part
   bpy.ops.mesh.primitive_cube_add(
       location=(
           handle_x,
           front_y - 0.002,
           handle_bottom + handle_height / 2
       )
   )
   cutter = bpy.context.object
   cutter.name = handle_name + "_Cutter"
   cutter.dimensions = (
       HANDLE_WIDTH,
       HANDLE_DEPTH,
       handle_height
   )
   bpy.ops.object.transform_apply(
       location=False,
       rotation=False,
       scale=True
   )
   # --------------------------------------------------------
   # Rounded top of the handle
   # --------------------------------------------------------
   bpy.ops.mesh.primitive_cylinder_add(
       vertices=32,
       radius=HANDLE_WIDTH / 2,
       depth=HANDLE_DEPTH,
       location=(
           handle_x,
           front_y - 0.002,
           handle_bottom + handle_height
       ),
       rotation=(math.radians(90), 0, 0)
   )
   round_cutter = bpy.context.object
   round_cutter.name = handle_name + "_Round"
   # --------------------------------------------------------
   # Join rectangular + round cutters
   # --------------------------------------------------------
   bpy.ops.object.select_all(action='DESELECT')
   cutter.select_set(True)
   round_cutter.select_set(True)
   bpy.context.view_layer.objects.active = cutter
   bpy.ops.object.join()
   cutter = bpy.context.object
   # --------------------------------------------------------
   # Boolean Difference
   # --------------------------------------------------------
   bpy.context.view_layer.objects.active = door_obj
   modifier = door_obj.modifiers.new(
       name=handle_name + "_Recess",
       type='BOOLEAN'
   )
   modifier.operation = 'DIFFERENCE'
   modifier.solver = 'EXACT'
   modifier.object = cutter
   bpy.context.view_layer.objects.active = door_obj
   bpy.ops.object.modifier_apply(
       modifier=modifier.name
   )
   # Delete cutter after Boolean
   bpy.data.objects.remove(
       cutter,
       do_unlink=True
   )
# ============================================================
# SHARED RECESSED HANDLES
# 4 DOORS = 3 SHARED HANDLES
# Each handle is CUT INTO BOTH ADJACENT DOORS
# ============================================================
HANDLE_TOTAL_WIDTH = 0.050
HANDLE_DEPTH = 0.045
HANDLE_HEIGHT = 0.62
# Bottom of handle from floor
HANDLE_BOTTOM = 0.82
# Half of the handle cut goes into each door
HANDLE_HALF_WIDTH = HANDLE_TOTAL_WIDTH / 2
# ============================================================
# CREATE ONE HALF OF A SHARED HANDLE CUT
# ============================================================
def cut_handle_into_door(
   door_obj,
   handle_x,
   handle_name,
   side
):
   if door_obj is None:
       return
   # --------------------------------------------------------
   # RECTANGULAR PART OF CUT
   # --------------------------------------------------------
   bpy.ops.mesh.primitive_cube_add(
       location=(
           handle_x,
           front_y - 0.015,
           HANDLE_BOTTOM
           + (HANDLE_HEIGHT - HANDLE_HALF_WIDTH) / 2
       )
   )
   cutter = bpy.context.object
   cutter.name = handle_name + "_Cutter"
   cutter.dimensions = (
       HANDLE_HALF_WIDTH,
       HANDLE_DEPTH,
       HANDLE_HEIGHT - HANDLE_HALF_WIDTH
   )
   bpy.ops.object.transform_apply(
       location=False,
       rotation=False,
       scale=True
   )
   # --------------------------------------------------------
   # ROUNDED TOP
   # --------------------------------------------------------
   bpy.ops.mesh.primitive_cylinder_add(
       vertices=32,
       radius=HANDLE_HALF_WIDTH / 2,
       depth=HANDLE_DEPTH,
       location=(
           handle_x,
           front_y - 0.015,
           HANDLE_BOTTOM
           + HANDLE_HEIGHT
           - HANDLE_HALF_WIDTH / 2
       ),
       rotation=(math.radians(90), 0, 0)
   )
   round_part = bpy.context.object
   round_part.name = handle_name + "_Round"
   # --------------------------------------------------------
   # JOIN CUTTER PIECES
   # --------------------------------------------------------
   bpy.ops.object.select_all(action='DESELECT')
   cutter.select_set(True)
   round_part.select_set(True)
   bpy.context.view_layer.objects.active = cutter
   bpy.ops.object.join()
   cutter = bpy.context.object
   # --------------------------------------------------------
   # BOOLEAN DIFFERENCE
   # --------------------------------------------------------
   bpy.context.view_layer.objects.active = door_obj
   modifier = door_obj.modifiers.new(
       name=handle_name + "_Recess",
       type='BOOLEAN'
   )
   modifier.operation = 'DIFFERENCE'
   modifier.solver = 'EXACT'
   modifier.object = cutter
   bpy.ops.object.modifier_apply(
       modifier=modifier.name
   )
   # --------------------------------------------------------
   # DELETE CUTTER
   # --------------------------------------------------------
   bpy.data.objects.remove(
       cutter,
       do_unlink=True
   )
# ============================================================
# 3 SHARED HANDLES
# ============================================================
for seam in range(1, MAIN_DOOR_COUNT):
   # --------------------------------------------------------
   # X POSITION OF DOOR MEETING LINE
   # --------------------------------------------------------
   seam_x = (
       x1
       - ROOM1_LENGTH / 2
       + seam * MAIN_DOOR_WIDTH
       + (seam - 0.5) * CupBoard_GAP
   )
   # --------------------------------------------------------
   # LEFT DOOR
   # --------------------------------------------------------
   left_door_index = seam
   # --------------------------------------------------------
   # RIGHT DOOR
   # --------------------------------------------------------
   right_door_index = seam + 1
   # --------------------------------------------------------
   # HANDLE CENTRE
   # --------------------------------------------------------
   handle_x_left = (
       seam_x - HANDLE_HALF_WIDTH / 2
   )
   handle_x_right = (
       seam_x + HANDLE_HALF_WIDTH / 2
   )
   # ========================================================
   # WHITE SECTION
   # ========================================================
   left_white = bpy.data.objects.get(
       f"CupBoard_MainDoor_{left_door_index}_White"
   )
   right_white = bpy.data.objects.get(
       f"CupBoard_MainDoor_{right_door_index}_White"
   )
   cut_handle_into_door(
       left_white,
       handle_x_left,
       f"SharedHandle_{seam}_Left_White",
       "LEFT"
   )
   cut_handle_into_door(
       right_white,
       handle_x_right,
       f"SharedHandle_{seam}_Right_White",
       "RIGHT"
   )
   # ========================================================
   # TERRACOTTA SECTION
   # ========================================================
   left_terracotta = bpy.data.objects.get(
       f"CupBoard_MainDoor_{left_door_index}_Terracotta"
   )
   right_terracotta = bpy.data.objects.get(
       f"CupBoard_MainDoor_{right_door_index}_Terracotta"
   )
   cut_handle_into_door(
       left_terracotta,
       handle_x_left,
       f"SharedHandle_{seam}_Left_Terracotta",
       "LEFT"
   )
   cut_handle_into_door(
       right_terracotta,
       handle_x_right,
       f"SharedHandle_{seam}_Right_Terracotta",
       "RIGHT"
   )
