# ============================================================
# ============================================================
# RECESSED SHARED HANDLE CUTS
# ============================================================
#
# IMPORTANT:
#
# There are 4 main doors.
#
# Therefore:
#
# Door 1 | Handle | Door 2 | Handle | Door 3 | Handle | Door 4
#
# = 3 SHARED HANDLES
#
# Each handle is CUT INTO BOTH DOORS.
#
# The SAME cutter crosses the door seam.
#
# The cutter is applied separately to:
#
# Door 1 White
# Door 1 Terracotta
# Door 2 White
# Door 2 Terracotta
#
# etc.
#
# This prevents the previous problem where only
# one side of the shared handle was being cut.
# ============================================================


# ============================================================
# HANDLE DIMENSIONS
# ============================================================

HANDLE_TOTAL_WIDTH = 0.050

HANDLE_RECESS_DEPTH = 0.012

HANDLE_HEIGHT = 1.20

HANDLE_BOTTOM = 0.18

HANDLE_RADIUS = (
    HANDLE_TOTAL_WIDTH / 2
)


# ============================================================
# HANDLE CUTTER DEPTH
#
# Slightly larger than recess depth so Boolean
# reliably intersects the door.
# ============================================================

HANDLE_CUTTER_DEPTH = 0.016


# ============================================================
# HANDLE CUTTER Y POSITION
#
# Door front face is toward negative Y.
# We cut into the front of the door but do NOT
# cut completely through the door.
# ============================================================

door_front_surface_y = (
    front_y
    - CupBoard_DOOR_THICKNESS / 2
)


handle_cutter_y = (
    door_front_surface_y
    - 0.002
    + HANDLE_CUTTER_DEPTH / 2
)


# ============================================================
# CREATE ONE SHARED HANDLE CUTTER
#
# Shape:
#
#       ______
#      /      \
#     |        |
#     |        |
#     |        |
#     |        |
#
# Rounded top
# Straight vertical body
# ============================================================

def create_shared_handle_cutter(
    handle_x,
    handle_name
):

    # --------------------------------------------------------
    # RECTANGULAR VERTICAL PART
    # --------------------------------------------------------

    straight_height = (
        HANDLE_HEIGHT
        - HANDLE_RADIUS
    )


    bpy.ops.mesh.primitive_cube_add(

        location=(

            handle_x,

            handle_cutter_y,

            HANDLE_BOTTOM
            + straight_height / 2

        )

    )


    cutter_body = bpy.context.object

    cutter_body.name = (
        handle_name
        + "_Vertical"
    )


    cutter_body.dimensions = (

        HANDLE_TOTAL_WIDTH,

        HANDLE_CUTTER_DEPTH,

        straight_height

    )


    bpy.ops.object.transform_apply(

        location=False,
        rotation=False,
        scale=True

    )


    # --------------------------------------------------------
    # ROUNDED TOP
    # --------------------------------------------------------

    rounded_top_z = (
        HANDLE_BOTTOM
        + HANDLE_HEIGHT
        - HANDLE_RADIUS
    )


    bpy.ops.mesh.primitive_cylinder_add(

        vertices=48,

        radius=HANDLE_RADIUS,

        depth=HANDLE_CUTTER_DEPTH,

        location=(

            handle_x,

            handle_cutter_y,

            rounded_top_z

        ),

        rotation=(

            math.radians(90),

            0,

            0

        )

    )


    cutter_round = bpy.context.object

    cutter_round.name = (
        handle_name
        + "_RoundedTop"
    )


    # --------------------------------------------------------
    # JOIN BOTH CUTTER PARTS
    # --------------------------------------------------------

    bpy.ops.object.select_all(
        action='DESELECT'
    )

    cutter_body.select_set(True)
    cutter_round.select_set(True)

    bpy.context.view_layer.objects.active = (
        cutter_body
    )

    bpy.ops.object.join()


    cutter = bpy.context.object

    cutter.name = (
        handle_name
        + "_Cutter"
    )


    return cutter


# ============================================================
# APPLY HANDLE CUT TO ONE DOOR
# ============================================================

def apply_handle_cut(
    door_obj,
    cutter,
    handle_name
):

    if door_obj is None:
        return


    # --------------------------------------------------------
    # BOOLEAN DIFFERENCE
    # --------------------------------------------------------

    bpy.context.view_layer.objects.active = (
        door_obj
    )

    door_obj.select_set(True)

    modifier = door_obj.modifiers.new(

        name=(
            handle_name
            + "_Recess"
        ),

        type='BOOLEAN'

    )

    modifier.operation = 'DIFFERENCE'

    modifier.solver = 'EXACT'

    modifier.object = cutter


    bpy.ops.object.modifier_apply(

        modifier=modifier.name

    )


    door_obj.select_set(False)


# ============================================================
# CREATE THE 3 SHARED HANDLES
# ============================================================

for seam in range(
    1,
    MAIN_DOOR_COUNT
):

    # ========================================================
    # FIND EXACT SEAM BETWEEN TWO DOORS
    # ========================================================

    seam_x = (
        x1
        - ROOM1_LENGTH / 2
        + seam * MAIN_DOOR_WIDTH
        + (
            seam
            - 0.5
        ) * CupBoard_GAP
    )


    # ========================================================
    # CREATE ONE CONTINUOUS CUTTER
    #
    # IMPORTANT:
    #
    # This cutter crosses the seam.
    #
    # Therefore the SAME handle shape is cut into:
    #
    # LEFT DOOR
    # +
    # RIGHT DOOR
    #
    # This is the correction for the previous
    # "only one door gets the handle" problem.
    # ========================================================

    cutter = create_shared_handle_cutter(

        seam_x,

        f"SharedHandle_{seam}"

    )


    # ========================================================
    # LEFT DOOR INDEX
    # ========================================================

    left_index = seam


    # ========================================================
    # RIGHT DOOR INDEX
    # ========================================================

    right_index = seam + 1


    # ========================================================
    # LEFT WHITE DOOR
    # ========================================================

    left_white = bpy.data.objects.get(

        f"CupBoard_MainDoor_"
        f"{left_index}_White"

    )


    # ========================================================
    # RIGHT WHITE DOOR
    # ========================================================

    right_white = bpy.data.objects.get(

        f"CupBoard_MainDoor_"
        f"{right_index}_White"

    )


    # ========================================================
    # LEFT TERRACOTTA DOOR
    # ========================================================

    left_terracotta = bpy.data.objects.get(

        f"CupBoard_MainDoor_"
        f"{left_index}_Terracotta"

    )


    # ========================================================
    # RIGHT TERRACOTTA DOOR
    # ========================================================

    right_terracotta = bpy.data.objects.get(

        f"CupBoard_MainDoor_"
        f"{right_index}_Terracotta"

    )


    # ========================================================
    # APPLY SAME HANDLE CUTTER TO ALL 4 PANELS
    #
    # LEFT WHITE
    # RIGHT WHITE
    # LEFT TERRACOTTA
    # RIGHT TERRACOTTA
    #
    # This makes the handle visually continuous
    # through the two-color door.
    # ========================================================

    apply_handle_cut(

        left_white,

        cutter,

        f"SharedHandle_{seam}_LeftWhite"

    )


    apply_handle_cut(

        right_white,

        cutter,

        f"SharedHandle_{seam}_RightWhite"

    )


    apply_handle_cut(

        left_terracotta,

        cutter,

        f"SharedHandle_{seam}_LeftTerracotta"

    )


    apply_handle_cut(

        right_terracotta,

        cutter,

        f"SharedHandle_{seam}_RightTerracotta"

    )


    # ========================================================
    # DELETE CUTTER AFTER ALL FOUR BOOLEAN CUTS
    # ========================================================

    bpy.data.objects.remove(

        cutter,

        do_unlink=True

    )


