# -------------------------------------------------
# CREATE BOX FUNCTION
# -------------------------------------------------
def create_box(name, location, dimensions, color_name=None, color=None):
   bpy.ops.mesh.primitive_cube_add(location=location)
   obj = bpy.context.object
   obj.name = name
   obj.dimensions = dimensions
   bpy.ops.object.transform_apply(
       location=False,
       rotation=False,
       scale=True
   )
   if color is not None:
       # Object viewport color
       obj.color = (
           color[0],
           color[1],
           color[2],
           1.0
       )
       # Create / get material
       material = bpy.data.materials.get(color_name)
       if material is None:
           material = bpy.data.materials.new(color_name)
       material.use_nodes = True
       # Set material color
       material.diffuse_color = (
           color[0],
           color[1],
           color[2],
           1.0
       )
       # Set Principled BSDF color
       nodes = material.node_tree.nodes
       bsdf = nodes.get("Principled BSDF")
       if bsdf is not None:
           bsdf.inputs["Base Color"].default_value = (
               color[0],
               color[1],
               color[2],
               1.0
           )
       # Assign material
       obj.data.materials.clear()
       obj.data.materials.append(material)
   return obj


